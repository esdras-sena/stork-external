# Copy to .env and fill in. .env is gitignored because it holds a private key.
#
#   cp .env.example .env
#
# Anything already set in the environment takes precedence over this file, so
# `STARKNET_RPC_URL=... npx tsx admin.ts deploy` still overrides it.

# Node to talk to. Providers serve different JSON-RPC spec versions on the same
# network, and the Go pusher needs 0.10.2 or newer to submit transactions.
# `npx tsx admin.ts preflight` reports the version of whatever you set here.
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com

# The account transactions are sent from. On Starknet an account is a contract,
# so this must be deployed and funded, not just a keypair.
STARKNET_ACCOUNT_ADDRESS=

# The Stark private key controlling that account. Keep this out of version control.
STARKNET_PRIVATE_KEY=

# Set after `deploy` prints it. Required by every command except deploy and preflight.
STORK_CONTRACT_ADDRESS=

# Stork's EVM signing key, used as the default for `deploy --stork-public-key`.
# Override for a non-production Stork environment.
STORK_EVM_PUBLIC_KEY=0x0a803F9b1CCe32e2773e0d2e98b37E0775cA5d44
